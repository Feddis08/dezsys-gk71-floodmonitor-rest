    "/api/v1/stations/{stationId}/statistics": {
      "get": {
        "tags": [
          "station-controller"
        ],
        "summary": "Statistics over retained measurements",
        "description": "Inclusive from/to window, valid readings only. Empty windows have null extrema/averages, zero counts/sum. totalRainfall is the sum of mm/h readings, not integrated rainfall. warningCount excludes criticalCount.",
        "operationId": "statistics",
        "parameters": [
          {
            "name": "stationId",
            "in": "path",
            "description": "Station identifier, e.g. ST-001; unknown IDs return 404",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Optional inclusive ISO-8601 instant, e.g. 2026-05-01T08:00:00Z",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Optional inclusive ISO-8601 instant, must be greater than or equal to from",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter, date, enum, boolean, range or limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Station, measurement or resource not found",
