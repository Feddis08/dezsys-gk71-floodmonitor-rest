  "components": {
    "schemas": {
      "Location": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Station": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "river": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "normalWaterLevel": {
            "type": "number",
            "format": "double"
          },
          "warningWaterLevel": {
            "type": "number",
            "format": "double"
          },
          "criticalWaterLevel": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Statistics": {
        "type": "object",
        "properties": {
          "stationId": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "measurementCount": {
            "type": "integer",
            "format": "int32"
          },
          "minWaterLevel": {
            "type": "number",
            "format": "double"
          },
          "maxWaterLevel": {
            "type": "number",
            "format": "double"
          },
          "averageWaterLevel": {
            "type": "number",
            "format": "double"
          },
          "averageFlowRate": {
            "type": "number",
            "format": "double"
          },
          "totalRainfall": {
            "type": "number",
            "format": "double"
          },
          "warningCount": {
            "type": "integer",
            "format": "int64"
          },
          "criticalCount": {
            "type": "integer",
            "format": "int64"
          }
        },
        "description": "Inclusive time window over retained valid measurements. Water: cm, flow: m³/s. totalRainfall is the sum of rainfall readings (mm/h), not integrated precipitation. Warning and critical counts are disjoint. Empty windows return null extrema/averages and zero counts/sum."
      },
      "Measurement": {
        "type": "object",
        "properties": {
          "stationId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "waterLevel": {
            "type": "number",
            "format": "double"
          },
          "flowRate": {
            "type": "number",
            "format": "double"
          },
          "rainfall": {
            "type": "number",
            "format": "double"
          },
          "temperature": {
            "type": "number",
            "format": "double"
          },
          "batteryLevel": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "string",
            "enum": [
              "ONLINE",
              "MAINTENANCE",
              "OFFLINE"
            ]
          },
          "warningLevel": {
            "type": "string",
            "enum": [
              "NORMAL",
              "WARNING",
              "CRITICAL",
              "UNKNOWN"
            ]
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    }
  }
}
