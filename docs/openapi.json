{
  "openapi": "3.0.1",
  "info": {
    "title": "Floodmonitor API",
    "description": "Public read-only flood monitoring API. No authentication is required. Only GET endpoints are provided; no administrative writes. No permissive CORS. Accept application/json (default) or application/xml. XML lists use <stations><station>…</station></stations> and <measurements><measurement>…</measurement></measurements>. Water levels are cm, flow m³/s, rainfall mm/h, temperature °C and battery %. NORMAL below warning threshold, WARNING from warning threshold, CRITICAL from critical threshold. UNKNOWN for missing, invalid, inactive, offline, future or stale current data; historical values are classified at measurement time. History is bounded by history.capacity (default 1000 per station).",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8873",
      "description": "Generated server url"
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/stations": {
      "get": {
        "tags": [
          "station-controller"
        ],
        "summary": "List stations",
        "description": "Filter by river, activity and current server-computed warning level. JSON array or XML stations/station list.",
        "operationId": "stations",
        "parameters": [
          {
            "name": "river",
            "in": "query",
            "description": "Optional case-insensitive exact river name, e.g. Donau",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isActive",
            "in": "query",
            "description": "Optional literal true or false; other values return 400",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "warningLevel",
            "in": "query",
            "description": "Optional enum NORMAL, WARNING, CRITICAL, UNKNOWN. Alerts include only current WARNING/CRITICAL",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "NORMAL",
                "WARNING",
                "CRITICAL",
                "UNKNOWN"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Station"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Station"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter, date, enum, boolean, range or limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Station, measurement or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "405": {
            "description": "Read-only API: method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "406": {
            "description": "Unsupported Accept; structured error falls back to JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error without stack trace or implementation details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": []
      }
    },
