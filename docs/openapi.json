    "/api/v1/stations/{stationId}/measurements": {
      "get": {
        "tags": [
          "station-controller"
        ],
        "summary": "Measurement history",
        "description": "Inclusive from/to window, newest first, filtered before limit. Historical warning is not invalidated by present age. JSON array or XML measurements/measurement list.",
        "operationId": "history",
        "parameters": [
          {
            "name": "stationId",
            "in": "path",
            "description": "Station identifier, e.g. ST-001; unknown IDs return 404",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Optional inclusive ISO-8601 instant, e.g. 2026-05-01T08:00:00Z",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Optional inclusive ISO-8601 instant, must be greater than or equal to from",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum returned readings, 1..1000 (default 100), newest first; applied after filters",
            "required": false,
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          },
          {
            "name": "warningLevel",
            "in": "query",
            "description": "Optional enum NORMAL, WARNING, CRITICAL, UNKNOWN. Alerts include only current WARNING/CRITICAL",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "NORMAL",
                "WARNING",
                "CRITICAL",
                "UNKNOWN"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "array",
                  "items": {
